# Copy this file to ".env" (same folder) and fill in real values.
# .env is gitignored - secrets never end up in the repository.

# --- Email delivery ---
# Transport is auto-detected: Resend > Brevo > SMTP > log-only.
# NOTE: SMTP works locally but is blocked on most cloud hosts (Render
# included), so deployments need one of the HTTP providers below.
#
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=your.verified@sender.com
#
# RESEND_API_KEY=re_...
# MAIL_FROM=EnduranceHub <onboarding@resend.dev>

# --- Local SMTP via Gmail ---
# 1. Enable 2-Step Verification on your Google account
# 2. Create an app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (remove spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your16charapppassword

# --- Optional overrides ---
# DATABASE_URL=postgresql://user:password@localhost:5432/endurancehub
# SECRET_KEY=generate-a-long-random-string-for-production
